# ── Server environment ───────────────────────────────────────────────────────
# Copy to .env and fill in. Required to run the API and the setup script.

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/atelier

# JWT signing secret (required) — any long random string
JWT_SECRET=change-this-to-a-long-random-string

# Server port (optional, default 5000)
PORT=5000

# ── Admin account created by `npm run setup` (optional overrides) ─────────────
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@atelier.dz
ADMIN_PASSWORD=changeme123
# SKIP_IMAGE_CHECK=1   # uncomment to skip the network image reachability check

# ── Cloudinary (required for image uploads from the admin dashboard) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email notifications on order status change (optional) ─────────────────────
EMAIL_USER=
EMAIL_PASS=
